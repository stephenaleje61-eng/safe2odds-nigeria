# =============================================================================
# Safe2Odds Nigeria — Production Environment Configuration (.env.example)
# Never commit real API keys, database credentials, or secret tokens to git.
# =============================================================================

PORT=3000
NODE_ENV=production
APP_URL="https://safe2odds.ng"

# --- Database & Cache ---
# Primary PostgreSQL Connection (Pooling enabled for 5M+ users)
DATABASE_URL="postgresql://safe2odds_user:STRONG_PASSWORD@db-primary.safe2odds.internal:5432/safe2odds_prod?sslmode=require&pool_max=50"
DATABASE_READ_REPLICA_URL="postgresql://safe2odds_read:STRONG_PASSWORD@db-replica.safe2odds.internal:5432/safe2odds_prod?sslmode=require&pool_max=100"

# Redis-compatible Cache Cluster (Weekly Leaderboard, Session Cache, Rate Limiting)
REDIS_URL="redis://:REDIS_AUTH_KEY@cache-cluster.safe2odds.internal:6379"

# --- Authentication & JWT Session Secret ---
SESSION_SECRET="GENERATE_HIGH_ENTROPY_RANDOM_SECRET_KEY_64_CHARS"
SESSION_DURATION_DAYS=7

# --- Alternative Supabase / Firebase Auth (Optional if using Managed BaaS) ---
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
# VITE_FIREBASE_AUTH_DOMAIN="safe2odds-prod.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="safe2odds-prod"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@safe2odds-prod.iam.gserviceaccount.com"

# --- External Sports Scores API Adapter (Optional) ---
# SPORTS_API_KEY="your_api_football_or_sportmonks_key"
